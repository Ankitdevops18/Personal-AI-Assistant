# Copy to .env inside your create-magnitude-app project.
# Preferred path — reuse the main gateway, no new secret:
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_MASTER_KEY=

# Fallback only if grounding doesn't survive the gateway route (see README) —
# uncomment magnitude.config.ts's anthropic block too if you use this:
# ANTHROPIC_API_KEY=
