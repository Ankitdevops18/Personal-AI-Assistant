# Copy this to .env and fill in real values. .env is gitignored — never commit it.

# --- LLM providers (add whichever you actually have keys for; gateway/config.yaml references these) ---
# ANTHROPIC_API_KEY is no longer used anywhere (6.13) — cheap-reliable (Haiku) moved to
# Bedrock's AWS creds below, same as frontier/premium. Left commented as a reminder not
# to reintroduce it by accident; delete this line once you've confirmed nothing needs it.
# ANTHROPIC_API_KEY=
OPENAI_API_KEY=      # premium-fallback (GPT-4o) — deliberately kept off Bedrock, see gateway/config.yaml's note on the `premium-fallback` entry
GROQ_API_KEY=       # free, no card — console.groq.com
CEREBRAS_API_KEY=   # free, no card — cloud.cerebras.ai
OPENROUTER_API_KEY= # openrouter.ai — used for `mid` (Nemotron), `free-openrouter`, and `experimental`

# --- AWS Bedrock (master plan 6.12, 6.13) — used for `frontier`, `premium`, `cheap-reliable`,
# and `bedrock-nova-micro`. No AWS_SESSION_TOKEN/api_key needed if you're using an AWS
# profile or an instance role instead of static keys — see gateway/README.md for the
# credential-chain options. Before any of this works: enable "Model access" for Claude
# Opus/Sonnet/Haiku and Amazon Nova Micro in the Bedrock console for AWS_REGION_NAME below
# (one-time, per region, usually instant).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed if AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY above are TEMPORARY credentials
# (from `aws sso login`, IAM Identity Center, or any STS AssumeRole flow) rather than a
# long-lived IAM user's static access keys. Leave blank for static keys. Missing this
# when using temporary credentials is a real, easy-to-hit cause of Bedrock's "Invalid
# Authentication: security token invalid" error (hit during Week 1 testing, 6.15).
AWS_SESSION_TOKEN=
AWS_REGION_NAME=     # e.g. us-east-1 (broadest, earliest model availability) or ap-south-1 (Mumbai, lower latency from Bengaluru) — verify Claude Opus/Sonnet/Haiku and Nova Micro are actually available in whichever region you pick

# --- LiteLLM proxy auth (protects your gateway from being called by anything but Hermes) ---
# Generate any random string, e.g. `openssl rand -hex 32`
LITELLM_MASTER_KEY=

# --- Gateway location (Hermes points here) ---
LITELLM_BASE_URL=http://localhost:4000/v1

# --- Spend tracking + budget enforcement + the cost/usage HUD's data source (see
# docs/COST_HUD.md). Same Postgres instance as memory/pgvector (Phase 2) — not a
# second database. LEFT COMMENTED OUT on purpose, not just blank: LiteLLM checks this
# env var directly, independent of whether gateway/config.yaml's general_settings.
# database_url is uncommented — a present-but-empty DATABASE_URL (uncommented, no value)
# makes LiteLLM try to parse "" as a connection string and crash with "unsupported
# scheme '<missing scheme>'" on startup. Uncomment and fill in only once the Phase 2
# Postgres actually exists; until then the gateway runs fine without it, just without
# budget enforcement or durable spend history. ---
# DATABASE_URL=
